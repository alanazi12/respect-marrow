# install dependencies and create zip
cd "$WORKDIR" || exit 1
echo "Installing dependencies (this may take a while)..."
npm install --no-audit --no-fund >/dev/null 2>&1 || echo "npm install failed or not available (you can run it manually)."

ZIPFILE="$HOME/respectmarro_ready.zip"
rm -f "$ZIPFILE"
cd ..
zip -r "$ZIPFILE" "$(basename "$WORKDIR")" >/dev/null 2>&1 || echo "zip failed, please zip the folder manually."

echo "DONE"
echo "Project created at: $WORKDIR"
echo "ZIP file: $ZIPFILE"
